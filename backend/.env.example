# Database Connection
MONGODB_URI=mongodb://localhost:27017/marketplace

# Authentication / Security (REQUIRED: min 256-bit string)
JWT_SECRET=your-256-bit-secret-key-must-be-at-least-32-chars-long

# JWT Token Expiration (seconds)
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email Verification (temporary default: false until email service is ready)
REQUIRE_EMAIL_VERIFICATION=false

# Account Lockout Settings
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_DURATION_MINUTES=15

# Initial Super Admin Seed (optional)
SUPER_ADMIN_EMAIL=admin@marketplace.local
SUPER_ADMIN_PASSWORD=change-me-super-admin-password
