# ===================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION (.env)
# ===================================================================
# NOTICE:
# ALL values in this file are dummy examples/placeholders.
# NEVER use these placeholder values in staging or production.
# NEVER commit real credentials, API keys, or connection strings.
#
# To generate a secure random 256-bit+ JWT_SECRET for your local .env, run:
#   openssl rand -base64 48
# ===================================================================

# Database Connection
MONGODB_URI=mongodb://localhost:27017/marketplace

# Authentication / Security (REQUIRED: min 256-bit string)
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-your-own-generated-secret-key-min-32-chars-long

# JWT Token Expiration (seconds)
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email Verification (temporary default: false for local development only)
# NOTE: Startup validator strictly blocks false in prod/production/staging profiles!
REQUIRE_EMAIL_VERIFICATION=false

# Account Lockout Settings
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_DURATION_MINUTES=15

# Initial Super Admin Seed (optional placeholders for local setup)
SUPER_ADMIN_EMAIL=admin@marketplace.local
SUPER_ADMIN_PASSWORD=change-me-super-admin-password
