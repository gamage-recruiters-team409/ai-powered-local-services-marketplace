    {
      "name": "2. Public Provider Profile API (/api/v1/providers/{id})",
      "description": "Public provider profile endpoint accepting Mongo profileId or provider userId.",
      "item": [
        {
          "name": "2.1 Get Public Profile by Provider User ID or Discovered ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/providers/{{validProviderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "providers",
                "{{validProviderId}}"
              ]
            },
            "description": "Fetches public provider profile by valid provider identifier."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// If test database is seeded with validProviderId, expect 200, otherwise 404",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Status code is 200 OK', function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "    pm.test('Response contains documented public profile fields', function () {",
                  "        var data = pm.response.json();",
                  "        pm.expect(data).to.have.property('providerId');",
                  "        pm.expect(data).to.have.property('name');",
                  "        pm.expect(data).to.have.property('verified');",
                  "        pm.expect(data).to.have.property('serviceTypes').that.is.an('array');",
                  "        pm.expect(data).to.have.property('listings').that.is.an('array');",
                  "        pm.expect(data).to.have.property('availabilityStatus').that.equals('UNAVAILABLE');",
                  "        pm.expect(data).to.have.property('supported');",
                  "    });",
                  "} else {",
                  "    pm.test('Status is 404 when unseeded database', function () {",
                  "        pm.response.to.have.status(404);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Verify Public Data Aggregate Contract (No Internal/PII Leakage)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/providers/{{validProfileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "providers",
                "{{validProfileId}}"
              ]
            },
            "description": "Verifies that sensitive internal/auth fields (e.g. customerId, bookingId, moderationReason, verificationDocuments) are NEVER leaked in public responses."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.test('Sensitive internal fields are NOT present', function () {",
                  "        pm.expect(data).to.not.have.property('customerId');",
                  "        pm.expect(data).to.not.have.property('bookingId');",
                  "        pm.expect(data).to.not.have.property('moderationReason');",
                  "        pm.expect(data).to.not.have.property('verificationDocuments');",
                  "        pm.expect(data).to.not.have.property('reviews');",
                  "    });",
                  "    pm.test('Supported flags explicitly show unsupported public features', function () {",
                  "        pm.expect(data.supported.distance).to.be.false;",
                  "        pm.expect(data.supported.availability).to.be.false;",
                  "        pm.expect(data.supported.reviewContent).to.be.false;",
                  "        pm.expect(data.supported.backgroundCheck).to.be.false;",
                  "    });",
                  "} else {",
                  "    pm.test('Handled with 404 for unseeded environment', function () {",
                  "        pm.expect([200, 404]).to.include(pm.response.code);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Non-Existent Provider Returns 404 (PROVIDER_PROFILE_NOT_FOUND)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
