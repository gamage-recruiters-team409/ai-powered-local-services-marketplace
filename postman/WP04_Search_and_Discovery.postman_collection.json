{
  "info": {
    "_postman_id": "wp04-search-discovery-m4",
    "name": "WP04 - Search, Discovery & Public Provider Profile API",
    "description": "Comprehensive automated Postman test collection for WP04 Public Search (`/api/v1/search`), Public Provider Profile (`/api/v1/providers/{providerId}`), and Security Boundaries.\n\nAuthor: Bimsara Rathnayake (WP04 Developer)\nWork Package: WP04 \u2013 Search, Discovery & Provider Comparison",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "validProviderId",
      "value": "user-1",
      "type": "string"
    },
    {
      "key": "validProfileId",
      "value": "profile-1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Public Search API (/api/v1/search)",
      "description": "Public search endpoint accepting query, location, category, maxPrice, verified status, sorting and pagination.",
      "item": [
        {
          "name": "1.1 Default Search (Envelope & Default Parameters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ]
            },
            "description": "Executes search with default parameters. Verifies envelope structure, default page=0, default size=12, and results array."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Response contains documented envelope fields', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('results');",
                  "    pm.expect(data.results).to.be.an('array');",
                  "    pm.expect(data).to.have.property('page').that.equals(0);",
                  "    pm.expect(data).to.have.property('size').that.equals(12);",
                  "    pm.expect(data).to.have.property('totalCount').that.is.at.least(0);",
                  "    pm.expect(data).to.have.property('unsupportedFilters').that.is.an('array');",
                  "});",
                  "",
                  "pm.test('If results exist, validate result schema', function () {",
                  "    var data = pm.response.json();",
                  "    if (data.results.length > 0) {",
                  "        var item = data.results[0];",
                  "        pm.expect(item).to.have.property('listingId');",
                  "        pm.expect(item).to.have.property('providerId');",
                  "        pm.expect(item).to.have.property('name');",
                  "        pm.expect(item).to.have.property('verified');",
                  "        pm.expect(item).to.have.property('pricing');",
                  "        pm.expect(item).to.have.property('supported');",
                  "        pm.expect(item.supported.distance).to.be.false;",
                  "        pm.expect(item.supported.availability).to.be.false;",
                  "        pm.environment.set('discoveredProviderId', item.providerId);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
